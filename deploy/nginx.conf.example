# Requires a provisioned certificate. Replace domain and certificate paths.
server {
    listen 80;
    server_name crm.sualoja.com.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name crm.sualoja.com.br;
    ssl_certificate /etc/letsencrypt/live/crm.sualoja.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.sualoja.com.br/privkey.pem;
    client_max_body_size 5m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Overwrite, never trust a client-provided protocol header.
        proxy_set_header X-Forwarded-Proto https;
    }
}
