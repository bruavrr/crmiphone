# Never commit the real .env. Secrets must be provided securely on the host.
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=crm.sualoja.com.br,127.0.0.1
POSTGRES_PASSWORD=
# URL-encode the database password in DATABASE_URL.
DATABASE_URL=postgresql://crm:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/premiumcrm
# disable only on the isolated local Compose network; use require for remote DB.
DB_SSLMODE=require
TRUST_PROXY=true
# Optional; integrations stay disconnected without these values.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
LEAD_API_KEY=
